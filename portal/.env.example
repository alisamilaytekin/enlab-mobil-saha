# Supabase Proje Ayarları (Supabase Dashboard -> Settings -> API)
SUPABASE_URL=https://PROJE_ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...gizli_service_role_anahtari...

# Portal Yönetici ve Uygulama Yükleme Anahtarı (Güçlü rastgele bir şifre belirleyin)
PORTAL_ADMIN_KEY=guclu-bir-yonetici-anahtari-belirleyin

# İsteğe bağlı: Müşteri PIN oturum imzalama anahtarı (boş bırakılırsa PORTAL_ADMIN_KEY türetilir)
PORTAL_TOKEN_SECRET=
